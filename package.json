{
  "engines": {
     "node": "24.x"
  },
  "scripts": {
    "client": "npm run dev --prefix frontend",
    "server": "npm run dev --prefix server",
    "buildServer": "cd server && npm install",
    "buildClient": "cd frontend && npm install --legacy-peer-deps",
    "globalDev": "concurrently \"npm run server\" \"npm run client\"",
    "clientBuild": "npm install --legacy-peer-deps --prefix frontend && npm run build --prefix frontend",
    "globalBuild": "npm run clientBuild && npm run buildServer"

  },
  "dependencies": {
    "brew": "^0.0.8"
  },
  "devDependencies": {
    "concurrently": "^10.0.0"
  }
}